# Copy to server/.env. Add only the providers you want to use.
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
DATA_DIR=./data
WORKSPACE_ROOT=./agent-workspaces

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# Optional model overrides. Defaults are documented in README.md.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash
DEEPSEEK_MODEL=deepseek-chat
PERPLEXITY_MODEL=llama-3.1-sonar-small-128k-online

# GitHub OAuth (optional). Create an OAuth app at:
# https://github.com/settings/developers
# Homepage URL: http://localhost:8787
# Authorization callback URL: http://localhost:8787/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8787/api/github/callback
