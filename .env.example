# Copy to server/.env. Add only the providers you want to use.
PORT=8787
# For local dev. On an internet deployment set this to your public HTTPS
# origin so OAuth callbacks redirect back to your site, e.g. https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:5173
DATA_DIR=./data
WORKSPACE_ROOT=./agent-workspaces

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
# OpenRouter (OpenAI-compatible gateway, free model tiers available)
OPENROUTER_API_KEY=
# OpenCode Zen (https://opencode.ai/auth) — free models incl. deepseek-v4-flash-free
OPENCODE_API_KEY=

# GitHub Copilot (optional). Reuses your connected GitHub OAuth token, or set an
# explicit token with Copilot access. Requires GitHub Copilot enabled on the account.
# GITHUB_TOKEN=
# COPILOT_MODEL=gpt-4o

# Optional model overrides. Defaults are documented in README.md.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash
DEEPSEEK_MODEL=deepseek-chat
PERPLEXITY_MODEL=llama-3.1-sonar-small-128k-online
OPENROUTER_MODEL=openai/gpt-4o-mini
# DeepSeek V4 Flash is free through Zen; switch to OPENCODE_MODEL for other models.
OPENCODE_MODEL=deepseek-v4-flash-free

# GitHub OAuth (optional). Create an OAuth app at:
# https://github.com/settings/developers
# Local install:
#   Homepage URL:             http://localhost:8787
#   Authorization callback:   http://localhost:8787/api/github/callback
# Internet deployment (use your public HTTPS domain instead):
#   Homepage URL:             https://yourdomain.com
#   Authorization callback:   https://yourdomain.com/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://yourdomain.com/api/github/callback
